LLM_PROVIDER=stepfun
MODEL_NAME=step-3.7-flash
EMBEDDING_MODEL_NAME=text-embedding-v3
TEMPERATURE=0.7

# Fill these in locally in backend/.env. Never commit real secrets.
STEP_API_KEY=
STEP_BASE_URL=https://api.stepfun.com/step_plan/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Use a PostgreSQL database with the pgvector extension available.
POSTGRES_DSN=postgresql://user:password@localhost:5432/lifesteward
REDIS_URL=redis://localhost:6379/0

LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=0.2
