LLM_PROVIDER=qwen
MODEL_NAME=qwen3.8-max
EMBEDDING_MODEL_NAME=text-embedding-v3
TEMPERATURE=0.7

# Fill these in locally in backend/.env. Never commit real secrets.
STEP_API_KEY=
STEP_BASE_URL=https://api.stepfun.com/step_plan/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Use a PostgreSQL database with the pgvector extension available.
POSTGRES_DSN=postgresql://user:password@localhost:5432/lifesteward
REDIS_URL=redis://localhost:6379/0

LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=0.2

# Comma-separated browser origins allowed by FastAPI. The public-demo script
# sets the current tunnel origin in its child process; do not use credentials
# with an unrestricted wildcard origin.
LIFESTEWARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LIFESTEWARD_CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?$|https://[a-z0-9-]+\.trycloudflare\.com$|https://[a-z0-9-]+(?:\.[a-z0-9-]+)*\.(?:loca\.lt|lhr\.life)$

# The generic StepFun endpoint was verified with the current model/key access.
# Use the /step_plan/v1 variant only when the account explicitly has Step Plan model access.
SPEECH_TO_TEXT_BASE_URL=https://api.stepfun.com/v1/audio/asr/sse
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_MODEL=stepaudio-2.5-asr
SPEECH_TO_TEXT_TIMEOUT=60
